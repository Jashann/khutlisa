# Copy to /etc/khutlisa/khutlisa.env on the VM, fill in, and `chmod 600` it. Never commit the filled file and
# never bake it into an image. Every line is KEY=value with no quotes.

# The holder's view. In the public demonstration this key is handed to every visitor's page on purpose
# (everything behind it is a demonstration), so use a value that is used nowhere else.
KHUTLISA_PAYER_KEY=

# Keeps the ids of register rows the same across restarts. Any long random text.
KHUTLISA_ID_SECRET=

# The language model. Without it the app still runs: speech and documents are not read, the holder's column
# mapping is made in code, and the notices use the translations that ship with the product.
ANTHROPIC_API_KEY=

# Airwallex sandbox keys, for the demonstration payments. Without them the payment screens say so.
AWX_CLIENT_ID=
AWX_API_KEY=

# The small daily budget of model calls in the public demonstration, and the per-client limits.
KHUTLISA_MODEL_CALLS_PER_DAY=150
KHUTLISA_REQUESTS_PER_MINUTE=240
KHUTLISA_REQUESTS_PER_HOUR=3000

# The four zip files of California's records, separated by spaces, copied from
# https://www.sco.ca.gov/upd_download_property_records.html in a browser. Leave empty to let the first start
# read the links from that page itself, or when the database is copied into the volume by hand.
KHUTLISA_REGISTER_URLS=
